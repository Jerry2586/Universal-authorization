{
  admin off
}

{$AUTH_DOMAIN} {
  encode zstd gzip
  reverse_proxy license-center:8787
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

{$BUILD_DOMAIN} {
  encode zstd gzip
  reverse_proxy build-center:8788
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
