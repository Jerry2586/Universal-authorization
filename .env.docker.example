# 只改下面两个域名，然后执行 sh scripts/docker.sh install。
# 两个 DNS A 记录必须指向当前服务器；Caddy 自动申请 HTTPS 证书并完成反向代理。
AUTH_DOMAIN=sq.your-domain.com
BUILD_DOMAIN=db.your-domain.com
LICENSE_SERVICE_ENABLED=true
CUSTOMER_LOGIN_ENABLED=true
BUILD_CENTER_ENABLED=true
NEW_BUILDS_ENABLED=true
WORKER_ENABLED=true
# 国内服务器如无法访问 Docker Hub，可改为可访问的兼容镜像地址。
APPGOG_NODE_IMAGE=node:24-bookworm-slim
APPGOG_CADDY_IMAGE=caddy:2.10
