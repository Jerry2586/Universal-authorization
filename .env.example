NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CHALLENGE_TTL_SECONDS=120

DATABASE_URL=postgresql://license:license@127.0.0.1:5432/license_server
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
INFRASTRUCTURE_CONNECT_TIMEOUT_MS=5000

REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=license-server:

# 管理 API 安全配置：正式使用前必须替换为两个不同的随机值，至少 32 个字符。
MANAGEMENT_GATEWAY_TOKEN=replace-management-token-at-least-32-characters
LICENSE_KEY_PEPPER=replace-license-key-pepper-at-least-32-characters

# 激活和服务端 Ed25519 签名配置。
# 运行 pnpm signing-key:generate，把输出的 LICENSE_SIGNING_PRIVATE_KEY_PEM_BASE64 整行复制到这里。
# 留空时服务端仍可启动，但所有需要服务端签名或验签的授权接口会安全拒绝服务。
LICENSE_SIGNING_PRIVATE_KEY_PEM_BASE64=
LICENSE_SIGNING_KEY_ID=license-signing-v1
LICENSE_TOKEN_ISSUER=universal-license-server
LICENSE_TOKEN_TTL_SECONDS=900
DEVICE_CERTIFICATE_TTL_SECONDS=2592000
ACTIVATION_REQUEST_MAX_SKEW_SECONDS=300
ACTIVATION_IDEMPOTENCY_TTL_SECONDS=86400

# 第五步在线验证和第六步会话生命周期配置；第七步管理员设备管理不新增环境变量。
LICENSE_REQUEST_MAX_SKEW_SECONDS=300
REQUEST_REPLAY_TTL_SECONDS=300
LICENSE_REFRESH_IDEMPOTENCY_TTL_SECONDS=86400
SESSION_ACTION_IDEMPOTENCY_TTL_SECONDS=86400

# 客户端建议每 60 秒心跳；Redis 在线标记 180 秒无心跳后自动消失。
HEARTBEAT_INTERVAL_SECONDS=60
SESSION_ONLINE_TTL_SECONDS=180
REFRESH_AFTER_SECONDS=600

POSTGRES_DB=license_server
POSTGRES_USER=license
POSTGRES_PASSWORD=license

