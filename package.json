{
  "name": "universal-license-server",
  "version": "0.8.0",
  "private": true,
  "description": "模块化通用 Key 授权服务端",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migration-status.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "signing-key:generate": "tsx scripts/generate-dev-signing-key.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "build:all": "pnpm web:build && pnpm build"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
